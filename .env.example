# Copier en « .env » (non versionné) et remplir.
#
# MAPBOX_TOKEN : carte de la fiche variétale. Sans lui, la fiche se rabat sur
# l'image statique assets/carte_guadeloupe.png — pas d'erreur, juste une carte
# moins précise.
MAPBOX_TOKEN=

# URL des photos servies par yamhub.fr. Sans elles, les fiches sortent sans
# feuille, sans recouvrement et sans les 64 photos de tubercules PANDA2.
LEAF_URL=https://yamhub.fr/photos/feuilles
RECOUV_URL=https://yamhub.fr/photos/recouvrement
TUBER_URL=https://yamhub.fr/photos/tubercules

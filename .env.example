# Copier en « .env » (non versionné) et remplir.
#
# MAPBOX_TOKEN : carte de la fiche variétale. Sans lui, la fiche se rabat sur
# l'image statique assets/carte_guadeloupe.png — pas d'erreur, juste une carte
# moins précise.
MAPBOX_TOKEN=

# URL des photos servies par yamhub.fr. Sans elles, les fiches sortent sans
# feuille, sans recouvrement et sans les 64 photos de tubercules PANDA2.
LEAF_URL=https://yamhub.fr/photos/feuilles
RECOUV_URL=https://yamhub.fr/photos/recouvrement
TUBER_URL=https://yamhub.fr/photos/tubercules

# Identifiants FTPS de yamhub.fr. Ils n'intéressent que l'outil de recadrage :
# sans eux, la case « Publier sur yamhub.fr à l'enregistrement » reste grisée et
# les photos recadrées ne quittent jamais le conteneur. Avec eux, chaque
# enregistrement part directement dans photos/recouvrement/<stade>/ et le
# dossier du stade est créé au besoin — c'est ce qui fait apparaître tout seul
# le bloc « 3 mois » dans la galerie, sans mise en ligne ni retouche de code.
YAMHUB_FTP_HOST=
YAMHUB_FTP_USER=
YAMHUB_FTP_PASS=

# Dossier des photos drone brutes sur la machine hôte, monté en lecture seule
# dans l'outil de recadrage (il s'y ouvre directement). À changer à chaque
# campagne.
DRONE_DIR=./data/sources/drone
